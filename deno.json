{
  "tasks": {
    "dev": "deno run -A src/main.ts",
    "test": "deno test -A",
    "test:battle": "deno test -A src/battle",
    "sim": "deno run -A scripts/sim_match.ts",
    "sim:battle": "deno run -A scripts/sim_battle_engine.ts",
    "check": "deno fmt --check && deno lint && deno test -A && deno run -A scripts/sim_match.ts",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "pinyin-pro": "npm:pinyin-pro@3.26.0"
  },
  "lint": {
    "exclude": ["supabase/.temp", "supabase/.branches"]
  },
  "fmt": {
    "exclude": ["supabase/.temp", "supabase/.branches"]
  }
}
