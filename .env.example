# 公网根地址，音效链接用它拼出来。Supabase 上形如：
# https://<project-ref>.supabase.co/functions/v1/mcp
PUBLIC_BASE_URL=

# 大于 1 时压缩吟唱、冷却和法力回复，只给本地演示用
LY_TIME_SCALE=1
PORT=8787
LY_LOG=1

# 有这两项才会在下一拍去灵矽拉对方原始念咒录音
LINX_API_BASE=https://xrobo.qiniu.com
LINX_API_KEY=

# 边缘函数里由 Supabase 自动注入；本地要连数据库时自己填
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web BFF 玩家会话签名，生产环境必须使用独立随机值
WEB_SESSION_SECRET=

# 七牛 Dora 短语音听写，仅由 Next.js 服务端读取
QINIU_DORA_ASR_URL=https://yitu-audio.qiniuapi.com/v2/asr
QINIU_DORA_ACCESS_KEY=
QINIU_DORA_SECRET_KEY=

# 可选 TTS 服务；不配置不会阻塞 Dora 语音转写
QINIU_AI_BASE_URL=
QINIU_AI_API_KEY=
QINIU_TTS_MODEL=
QINIU_TTS_VOICE=
# 未填写时使用 /audio/speech
QINIU_TTS_PATH=
