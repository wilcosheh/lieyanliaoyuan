# 公网 MCP 根地址。边缘函数上形如：
# https://<project-ref>.supabase.co/functions/v1/game/mcp
# 服务把它写成 SSE 的 endpoint，灵矽再向这个地址 POST /message。
PUBLIC_BASE_URL=

# 灵矽 MCP 配置里的连接密钥。不代表玩家。未设置时 /mcp 全部 401。
MCP_CONNECTION_KEY=

# 1 表示这把密钥的终端支持声纹，大厅可以说「两个人」。
MCP_VOICEPRINT=0

# Postgres 直连，端口 5432。不要用 6543 事务池化，否则 LISTEN 收不到通知。
DATABASE_URL=

# 大于 1 时压缩吟唱、冷却和法力回复，只给本地演示用
LY_TIME_SCALE=1
PORT=8787
LY_LOG=1

# 有这两项才会在下一拍去灵矽拉对方原始念咒录音
LINX_API_BASE=https://xrobo.qiniu.com
LINX_API_KEY=

# 边缘函数里由 Supabase 自动注入；本地要连数据库时自己填
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web BFF 玩家会话签名，生产环境必须使用独立随机值
WEB_SESSION_SECRET=

# 七牛 Dora 短语音听写，仅由 Next.js 服务端读取
QINIU_DORA_ASR_URL=https://yitu-audio.qiniuapi.com/v2/asr
QINIU_DORA_ACCESS_KEY=
QINIU_DORA_SECRET_KEY=

# 可选 TTS 服务；不配置不会阻塞 Dora 语音转写
QINIU_AI_BASE_URL=
QINIU_AI_API_KEY=
QINIU_TTS_MODEL=
QINIU_TTS_VOICE=
# 未填写时使用 /audio/speech
QINIU_TTS_PATH=
